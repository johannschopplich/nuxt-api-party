{
  "name": "nuxt-api-party",
  "type": "module",
  "version": "4.0.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Auto-generated composables for secure API access, with OpenAPI support",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://nuxt-api-party.byjohann.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/nuxt-api-party.git"
  },
  "bugs": "https://github.com/johannschopplich/nuxt-api-party/issues",
  "keywords": [
    "api",
    "fetch",
    "nuxt",
    "open-api",
    "openapi",
    "query"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "zx ./scripts/prepare-all.ts",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "bumpp"
  },
  "peerDependencies": {
    "openapi-typescript": "^7"
  },
  "peerDependenciesMeta": {
    "openapi-typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "apiful": "^5.0.1",
    "chokidar": "^5.0.0",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "jiti": "^2.7.0",
    "ofetch": "^1.5.1",
    "ohash": "^2.0.11",
    "openapi-typescript-helpers": "0.1.0",
    "pathe": "^2.0.3",
    "scule": "^1.3.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "^26.1.2",
    "bumpp": "^12.2.0",
    "destr": "^2.0.5",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.2",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9",
    "zx": "^8.8.5"
  }
}
